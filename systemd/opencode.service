[Unit]
Description=OpenCode Serve (v2 API, port 5100)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.openclaw/.opencode-password.env
ExecStart=%h/.opencode/bin/opencode serve --hostname=127.0.0.1 --port=5100
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
